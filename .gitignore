# === 白名单模式：只跟踪核心源代码目录 ===
# 先忽略所有文件
*

# === 保留 Git 配置和仓库文件 ===
!.gitignore
!.github/
!.github/**
!LICENSE
!README.md

# === 核心源代码目录（每次更新同步这些） ===
!config/
!config/**
!kubejs/
!kubejs/**
!ldlib2/
!ldlib2/**
!docs/
!docs/**

# === 在以上目录中仍需排除的用户/运行时数据 ===

# JEI 世界特定数据（书签、历史记录等用户数据）
config/jei/world/
config/jei_mekanism_multiblocks-saved_data.nbt

# TabTPS 用户数据
config/tabtps/userdata/

# Xaero 地图数据（用户特定）
config/xaero/

# FancyMenu 用户变量数据库
config/fancymenu/user_variables.db
config/fancymenu/options.txt

# DrippyLoadingScreen 用户选项
config/drippyloadingscreen/options.txt

# 备份文件
*.bak

# KubeJS 运行时生成的数据
kubejs/exported/

# === ldlib2 / MBD2 运行时生成文件 ===
# NBT 格式的运行时资源（渲染器、蓝图、谓词等，由编辑器自动生成）
*.nbt

# ldlib2 编辑器布局和备份
ldlib2/editor_layouts/
ldlib2/backups/

# ldlib2 自动生成的资源文件（保留 .sm .mb .rt 机器定义文件）
ldlib2/assets/ldlib2/resources/
ldlib2/assets/mbd2/blueprint/
